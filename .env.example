# Server-only PayPal credentials: never prefix with NEXT_PUBLIC_
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id
PAYPAL_ENV=sandbox
APP_URL=http://localhost:3000

# Keep the existing Supabase project and credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Keep your existing Google Sheets URLs and business number
ABROAD_CATALOG_SHEET_URL=
ABROAD_BUNDLES_SHEET_URL=
ABROAD_GOOGLE_SHEET_URL=
ABROAD_COMBOS_SHEET_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-only admin push configuration
ADMIN_PUSH_WEBHOOK_URL=https://admin-gb.vercel.app/api/admin/push/abroad-order
ADMIN_PUSH_WEBHOOK_SECRET=your_existing_admin_push_secret

# Optional footer settings (retain your current values if configured)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PARENT_SITE_URL=https://godavaribasket.com
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
